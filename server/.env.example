PORT=5000
MONGO_URI=mongodb://localhost:27017/event-booking
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email - Resend (Recommended for Render, uses HTTPS API)
RESEND_API_KEY=re_123456789
EMAIL_FROM="EventBook <onboarding@resend.dev>"

# Email - Fallback Nodemailer (Gmail SMTP - Note: blocked on Render free tier)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

CLIENT_URL=http://localhost:3000
NODE_ENV=development
